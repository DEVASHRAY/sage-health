# Copy to .env (never commit .env). Read once at startup by apps/api/src/config/env.ts.

# Postgres connection string used by the API and by `prisma migrate`.
DATABASE_URL=postgresql://sage@127.0.0.1:54329/sage

# Separate database for the Prisma integration suite. It is truncated between tests.
# When unset, the integration suite is skipped (everything else still runs).
TEST_DATABASE_URL=postgresql://sage@127.0.0.1:54329/sage_test

# Google Gemini API key (sent as the x-goog-api-key header).
GEMINI_API_KEY=replace-me

# Ordered, comma-separated fallback chain of Gemini model ids.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Per-attempt timeout for one model call, in milliseconds.
ESTIMATE_TIMEOUT_MS=12000

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated browser origins allowed by CORS. Empty disables CORS (native apps do not need it).
CORS_ORIGINS=

# Per-device limit on POST /v1/meals/estimate.
ESTIMATE_RATE_LIMIT_PER_MINUTE=30
